  "capture_runner_source": "import { spawnSync } from 'node:child_process';\nimport { openSync, closeSync, writeFileSync } from 'node:fs';\n\nconst [prefix, command, ...args] = process.argv.slice(2);\nif (!prefix || !command) throw new Error('Usage: capture-proof.mjs <output-prefix> <command> [args...]');\nconst cwd = process.cwd();\nconst git = (...args) => {\n  const result = spawnSync('git', args, { cwd, encoding: 'utf8' });\n  return { args, exit: result.status, stdout: result.stdout, stderr: result.stderr };\n};\nconst before = { head: git('rev-parse', 'HEAD'), status: git('status', '--porcelain') };\nconst started_at = new Date().toISOString();\nconst stdout_path = `${prefix}.stdout`;\nconst stderr_path = `${prefix}.stderr`;\nconst stdout = openSync(stdout_path, 'wx');\nconst stderr = openSync(stderr_path, 'wx');\nconst result = spawnSync(command, args, { cwd, stdio: ['ignore', stdout, stderr], timeout: 900000 });\ncloseSync(stdout);\ncloseSync(stderr);\nconst receipt = { command: [command, ...args], cwd, before, after: { head: git('rev-parse', 'HEAD'), status: git('status', '--porcelain') }, started_at, finished_at: new Date().toISOString(), exit: result.status, signal: result.signal, error: result.error?.message, stdout_path, stderr_path };\nwriteFileSync(`${prefix}.json`, `${JSON.stringify(receipt, null, 2)}\\n`, { flag: 'wx' });\nconsole.log(JSON.stringify(receipt));\nprocess.exitCode = result.status ?? 1;\n",
